{
  "name": "example-next-app",
  "private": true,
  "scripts": {
    "build:turbopack": "viewer-assets copy public/viewer-assets && next build --turbopack",
    "build:webpack": "viewer-assets copy public/viewer-assets && next build --webpack",
    "serve": "next start --port ${PORT:-3000} --hostname 127.0.0.1",
    "dev:turbopack": "viewer-assets copy public/viewer-assets && next dev --turbopack --port ${PORT:-3000} --hostname 127.0.0.1",
    "dev:webpack": "viewer-assets copy public/viewer-assets && next dev --webpack --port ${PORT:-3000} --hostname 127.0.0.1"
  },
  "dependencies": {
    "@01x/dicom-viewer-core": "0.0.0",
    "@01x/dicom-viewer-react": "0.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
