{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "isolatedDeclarations": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "*.js",
    "packages/*/*.config.ts",
    "tools/*/*.config.ts",
    "scripts/**/*.ts",
    "tools/*/src/*.d.ts"
  ]
}
