{
  "name": "dicom-viewer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "generate": "pnpm --filter @01x/dicom-viewer-core generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" typecheck",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm generate && pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "size": "size-limit",
    "visual": "node scripts/visual/run.ts",
    "docs:api": "typedoc",
    "package-check": "node scripts/package-check.ts",
    "matrix": "node scripts/matrix/run.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@size-limit/file": "14.2.0",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "jsdom": "30.1.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "tsdown": "0.23.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
