{
  "name": "dicom-viewer-site",
  "private": true,
  "type": "module",
  "description": "The landing page and live demo, published to GitHub Pages.",
  "scripts": {
    "guides": "node scripts/build-guides.ts",
    "dev": "pnpm guides && vite --host 127.0.0.1",
    "build": "pnpm guides && tsc -p tsconfig.json && vite build --base ./",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@01x/dicom-viewer-core": "workspace:*",
    "@01x/dicom-viewer-elements": "workspace:*",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "markdown-it": "14.3.2",
    "shiki": "3.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
