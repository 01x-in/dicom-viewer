{
  "name": "@01x/dicom-viewer-react",
  "version": "1.0.2",
  "description": "React adapter for the DICOM viewer. Works in Vite and Next.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01x-in/dicom-viewer.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/01x-in/dicom-viewer#readme",
  "bugs": {
    "url": "https://github.com/01x-in/dicom-viewer/issues"
  },
  "keywords": [
    "dicom",
    "react",
    "nextjs",
    "viewer"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@01x/dicom-viewer-core": "workspace:*",
    "@01x/dicom-viewer-elements": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
