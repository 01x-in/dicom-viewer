  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@scope/viewer-core": "workspace:*",
    "@scope/viewer-elements": "workspace:*"
  },
  "devDependencies": {
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
