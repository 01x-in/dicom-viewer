{
  "name": "@scope/viewer-vue",
  "version": "0.0.0",
  "description": "Vue 3 adapter for the DICOM viewer. Works in Vite and Nuxt.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
