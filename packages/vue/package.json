{
  "name": "@01x/dicom-viewer-vue",
  "version": "1.0.1",
  "description": "Vue 3 adapter for the DICOM viewer. Works in Vite and Nuxt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01x-in/dicom-viewer.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/01x-in/dicom-viewer#readme",
  "bugs": {
    "url": "https://github.com/01x-in/dicom-viewer/issues"
  },
  "keywords": [
    "dicom",
    "vue",
    "nuxt",
    "viewer"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@01x/dicom-viewer-core": "workspace:*",
    "@01x/dicom-viewer-elements": "workspace:*"
  },
  "devDependencies": {
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
