{
  "name": "@scope/viewer-core",
  "version": "0.0.0",
  "description": "Headless DICOM viewer core built on Cornerstone3D.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "generate": "node scripts/build-workers.ts --if-missing",
    "build": "node scripts/build-workers.ts && tsdown",
    "typecheck": "pnpm generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cornerstonejs/adapters": "5.11.4",
    "@cornerstonejs/core": "5.11.4",
    "@cornerstonejs/dicom-image-loader": "5.11.4",
    "@cornerstonejs/metadata": "5.11.4",
    "@cornerstonejs/tools": "5.11.4",
    "events": "3.3.0",
    "rolldown": "1.2.12"
  },
  "bin": {
    "viewer-assets": "./dist/bin/viewer-assets.js"
  }
}
