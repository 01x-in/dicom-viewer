{
  "name": "@01x/dicom-viewer-core",
  "version": "1.0.0",
  "description": "Headless DICOM viewer core built on Cornerstone3D.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01x-in/dicom-viewer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/01x-in/dicom-viewer#readme",
  "bugs": {
    "url": "https://github.com/01x-in/dicom-viewer/issues"
  },
  "keywords": [
    "dicom",
    "cornerstone3d",
    "medical-imaging",
    "viewer",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./viewer-config.schema.json": "./schema/viewer-config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "schema"
  ],
  "scripts": {
    "generate": "node scripts/build-workers.ts --if-missing",
    "build": "node scripts/build-workers.ts && tsdown",
    "typecheck": "pnpm generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.2",
    "@cornerstonejs/adapters": "5.11.4",
    "@cornerstonejs/core": "5.11.4",
    "@cornerstonejs/dicom-image-loader": "5.11.4",
    "@cornerstonejs/metadata": "5.11.4",
    "@cornerstonejs/tools": "5.11.4",
    "dicom-parser": "1.8.21",
    "events": "3.3.0",
    "rolldown": "1.2.12"
  },
  "bin": {
    "viewer-assets": "dist/bin/viewer-assets.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
