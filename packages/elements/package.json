{
  "name": "@01x/dicom-viewer-elements",
  "version": "1.0.1",
  "description": "Styled DICOM viewer UI as framework-neutral web components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01x-in/dicom-viewer.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/01x-in/dicom-viewer#readme",
  "bugs": {
    "url": "https://github.com/01x-in/dicom-viewer/issues"
  },
  "keywords": [
    "dicom",
    "web-components",
    "lit",
    "viewer"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@01x/dicom-viewer-core": "workspace:*",
    "lit": "3.3.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
